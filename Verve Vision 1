<script>

/* =========================================================
   VV1 PAGE NAVIGATION
========================================================= */

function showPage(pageId, button, autoStart = true){

    document.querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    const page =
        document.getElementById(pageId);


    if(page){

        page.classList.add("active");

    }


    document.querySelectorAll("nav button")
        .forEach(btn => {

            btn.classList.remove("active");

        });


    if(button){

        button.classList.add("active");

    }


    window.scrollTo({
        top:0,
        behavior:"smooth"
    });


    if(
        pageId === "watch" &&
        autoStart
    ){

        setTimeout(() => {

            startLive();

        },150);

    }

}


/* =========================================================
   CHANNEL DATABASE
========================================================= */

const CHANNELS = {

    aljazeera:{

        name:
            "AL JAZEERA ENGLISH",

        shortName:
            "AL JAZEERA ENGLISH • LIVE",

        sourceLabel:
            "HLS • AL JAZEERA ENGLISH",

        sources:[

            "https://live-hls-apps-aje-fa.getaj.net/AJE/index.m3u8",

            "https://live-hls-web-aje-gcp.thehlive.com/AJE/index.m3u8"

        ]

    },


    cbs:{

        name:
            "CBS NEWS 24/7",

        shortName:
            "CBS NEWS 24/7 • LIVE",

        sourceLabel:
            "HLS • CBS NEWS 24/7",

        sources:[

            "https://cbsn-us.cbsnstream.cbsnews.com/out/v1/55a8648e8f134e82a470f83d562deeca/master.m3u8"

        ]

    }

};


/* =========================================================
   CURRENT CHANNEL STATE
========================================================= */

let currentChannel =
    "aljazeera";

let currentSource =
    0;

let hls =
    null;


/* =========================================================
   PLAYER UI
========================================================= */

function updatePlayerUI(){

    const channel =
        CHANNELS[currentChannel];


    if(!channel){
        return;
    }


    const name =
        document.getElementById(
            "playerChannelName"
        );


    const source =
        document.getElementById(
            "playerSource"
        );


    const sourceLabel =
        document.getElementById(
            "playerSourceLabel"
        );


    const watchStatus =
        document.getElementById(
            "watchStatus"
        );


    const message =
        document.getElementById(
            "playerMessage"
        );


    if(name){
        name.textContent =
            channel.shortName;
    }


    if(source){
        source.textContent =
            channel.sourceLabel;
    }


    if(sourceLabel){
        sourceLabel.textContent =
            "LIVE HLS";
    }


    if(watchStatus){
        watchStatus.textContent =
            channel.name;
    }


    if(message){
        message.textContent =
            "CONNECTING TO " +
            channel.name +
            "...";
    }

}


/* =========================================================
   ACTIVE CHANNEL
========================================================= */

function updateActiveChannel(){

    document.querySelectorAll(
        ".channel-card"
    ).forEach(card => {

        card.classList.remove(
            "active-channel"
        );

    });


    const active =
        document.getElementById(
            "channel-" +
            currentChannel
        );


    if(active){

        active.classList.add(
            "active-channel"
        );

    }

}


/* =========================================================
   START LIVE
========================================================= */

function startLive(){

    const video =
        document.getElementById(
            "vv1LivePlayer"
        );


    if(!video){
        return;
    }


    const channel =
        CHANNELS[currentChannel];


    if(!channel){
        return;
    }


    if(hls){

        hls.destroy();

        hls = null;

    }


    const sources =
        channel.sources;


    const source =
        sources[currentSource];


    updatePlayerUI();

    updateActiveChannel();


    console.log(
        "VV1 LIVE →",
        channel.name,
        source
    );


    /*
       Native HLS.
    */

    if(
        video.canPlayType(
            "application/vnd.apple.mpegurl"
        )
    ){

        video.src =
            source;

        video.load();


        video.play()
            .then(() => {

                const message =
                    document.getElementById(
                        "playerMessage"
                    );

                if(message){
                    message.textContent = "";
                }

            })
            .catch(() => {

                console.log(
                    "Autoplay blocked — press play."
                );

            });


        return;

    }


    /*
       HLS.js.
    */

    if(
        typeof Hls !== "undefined" &&
        Hls.isSupported()
    ){

        hls =
            new Hls({

                enableWorker:true,

                lowLatencyMode:true,

                backBufferLength:30,

                maxBufferLength:30,

                manifestLoadingMaxRetry:3,

                levelLoadingMaxRetry:3,

                fragLoadingMaxRetry:3

            });


        hls.loadSource(
            source
        );


        hls.attachMedia(
            video
        );


        hls.on(
            Hls.Events.MANIFEST_PARSED,
            () => {

                const message =
                    document.getElementById(
                        "playerMessage"
                    );


                if(message){
                    message.textContent = "";
                }


                video.play()
                    .catch(error => {

                        if(
                            error.name ===
                            "NotAllowedError"
                        ){

                            console.log(
                                "Autoplay blocked — press play."
                            );

                        }

                    });

            }
        );


        hls.on(
            Hls.Events.ERROR,
            (event,data) => {

                console.error(
                    "VV1 HLS ERROR:",
                    currentChannel,
                    data
                );


                if(data.fatal){

                    if(
                        currentSource <
                        sources.length - 1
                    ){

                        currentSource++;

                        console.log(
                            "VV1 → trying backup source"
                        );

                        startLive();

                    }else{

                        showLiveError();

                    }

                }

            }
        );


    }else{

        showLiveError();

    }

}


/* =========================================================
   LIVE ERROR
========================================================= */

function showLiveError(){

    const video =
        document.getElementById(
            "vv1LivePlayer"
        );


    const message =
        document.getElementById(
            "playerMessage"
        );


    if(message){

        message.textContent =
            "UNABLE TO LOAD " +
            CHANNELS[currentChannel].name +
            " LIVE FEED";

    }


    if(video){

        video.pause();

        video.removeAttribute("src");

        video.load();

    }


    console.log(
        "VV1: No working stream available for",
        currentChannel
    );

}


/* =========================================================
   ENTER FULLSCREEN
========================================================= */

function enterVV1Fullscreen(){

    const player =
        document.getElementById(
            "vv1PlayerContainer"
        );


    if(!player){
        return;
    }


    /*
       Remove fallback first.
    */

    player.classList.remove(
        "vv1-fallback-fullscreen"
    );


    /*
       IMPORTANT:
       requestFullscreen is called directly
       from the user's button/card click.
       Do NOT put this inside setTimeout.
    */

    try{

        if(
            player.requestFullscreen
        ){

            const promise =
                player.requestFullscreen();

            if(
                promise &&
                promise.catch
            ){

                promise.catch(error => {

                    console.warn(
                        "VV1 fullscreen request failed:",
                        error
                    );

                    useVV1FullscreenFallback(
                        player
                    );

                });

            }

        }else if(
            player.webkitRequestFullscreen
        ){

            player.webkitRequestFullscreen();

        }else if(
            player.webkitEnterFullscreen
        ){

            player.webkitEnterFullscreen();

        }else{

            useVV1FullscreenFallback(
                player
            );

        }

    }catch(error){

        console.error(
            "VV1 fullscreen error:",
            error
        );

        useVV1FullscreenFallback(
            player
        );

    }

}


/* =========================================================
   FULLSCREEN FALLBACK
========================================================= */

function useVV1FullscreenFallback(player){

    player.classList.add(
        "vv1-fallback-fullscreen"
    );

}


/* =========================================================
   EXIT FULLSCREEN
========================================================= */

function exitVV1Fullscreen(){

    const player =
        document.getElementById(
            "vv1PlayerContainer"
        );


    /*
       Browser fullscreen.
    */

    try{

        if(
            document.fullscreenElement
        ){

            document.exitFullscreen();

        }else if(
            document.webkitFullscreenElement
        ){

            if(
                document.webkitExitFullscreen
            ){

                document.webkitExitFullscreen();

            }

        }else if(
            document.mozFullScreenElement
        ){

            if(
                document.mozCancelFullScreen
            ){

                document.mozCancelFullScreen();

            }

        }

    }catch(error){

        console.error(
            "VV1 exit fullscreen error:",
            error
        );

    }


    /*
       CSS fallback.
    */

    if(player){

        player.classList.remove(
            "vv1-fallback-fullscreen"
        );

    }


    unlockOrientation();

}


/* =========================================================
   ORIENTATION LOCK
========================================================= */

async function lockVV1Landscape(){

    try{

        if(
            screen.orientation &&
            screen.orientation.lock
        ){

            await screen.orientation.lock(
                "landscape"
            );

            console.log(
                "VV1 → LANDSCAPE LOCK"
            );

        }

    }catch(error){

        /*
           Some browsers don't allow
           orientation locking.
        */

        console.log(
            "VV1: Landscape orientation lock unavailable."
        );

    }

}


/* =========================================================
   ORIENTATION UNLOCK
========================================================= */

function unlockOrientation(){

    try{

        if(
            screen.orientation &&
            screen.orientation.unlock
        ){

            screen.orientation.unlock();

        }

    }catch(error){

        console.log(
            "VV1: Orientation unlock unavailable."
        );

    }

}


/* =========================================================
   FULLSCREEN CHANGE
========================================================= */

document.addEventListener(
    "fullscreenchange",
    handleFullscreenChange
);


/*
   WebKit fullscreen change.
*/

document.addEventListener(
    "webkitfullscreenchange",
    handleFullscreenChange
);


function handleFullscreenChange(){

    const player =
        document.getElementById(
            "vv1PlayerContainer"
        );


    if(!player){
        return;
    }


    const isFullscreen =
        document.fullscreenElement === player ||
        document.webkitFullscreenElement === player ||
        document.mozFullScreenElement === player;


    if(isFullscreen){

        /*
           The fullscreen transition has now
           happened. This is the correct point
           to request landscape orientation.
        */

        lockVV1Landscape();

    }else{

        unlockOrientation();

        player.classList.remove(
            "vv1-fallback-fullscreen"
        );

    }

}


/* =========================================================
   SELECT CHANNEL
========================================================= */

function selectChannel(channel){

    if(!CHANNELS[channel]){
        return;
    }


    currentChannel =
        channel;


    currentSource =
        0;


    /*
       Change page WITHOUT scheduling
       another startLive().
    */

    showPage(
        "watch",
        null,
        false
    );


    /*
       Start selected channel immediately.
    */

    startLive();


    /*
       Scroll toward player.
    */

    const player =
        document.getElementById(
            "vv1PlayerContainer"
        );


    if(player){

        player.scrollIntoView({
            behavior:"smooth",
            block:"center"
        });

    }


    /*
       IMPORTANT:
       Fullscreen request remains directly
       inside the original channel click.
    */

    enterVV1Fullscreen();

}


/* =========================================================
   RECONNECT
========================================================= */

function reloadLive(){

    currentSource =
        0;

    startLive();

}


/* =========================================================
   EAT CLOCK
========================================================= */

function updateClock(){

    const now =
        new Date();


    const utc =
        now.getTime() +
        now.getTimezoneOffset() *
        60000;


    const eat =
        new Date(
            utc +
            3 *
            60 *
            60000
        );


    const h =
        String(
            eat.getHours()
        ).padStart(
            2,
            "0"
        );


    const m =
        String(
            eat.getMinutes()
        ).padStart(
            2,
            "0"
        );


    const s =
        String(
            eat.getSeconds()
        ).padStart(
            2,
            "0"
        );


    const clock =
        document.getElementById(
            "clock"
        );


    if(clock){

        clock.textContent =
            `${h}:${m}:${s} EAT`;

    }

}


setInterval(
    updateClock,
    1000
);


updateClock();


/* =========================================================
   MOBILE TICKER
========================================================= */

if(
    window.innerWidth < 600
){

    const ticker =
        document.querySelector(
            ".ticker-text"
        );


    if(ticker){

        ticker.style.animationDuration =
            "35s";

    }

}


/* =========================================================
   INITIALIZE VV1
========================================================= */

updatePlayerUI();

updateActiveChannel();

startLive();

</script>

