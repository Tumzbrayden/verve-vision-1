<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>VV1 | Verve Vision 1</title>

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

<style>

/* =========================================================
   VV1 CORE
========================================================= */

:root{
    --black:#050505;
    --panel:#0d0d0f;
    --panel2:#15151a;

    --green:#39FF14;

    --purple:#8A2BE2;
    --purple2:#5d18a8;

    --white:#f5f5f5;
    --muted:#999;

    --red:#ff3131;

    --line:#27272c;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--black);
    color:var(--white);
    font-family:Arial,Helvetica,sans-serif;
    overflow-x:hidden;
}


/* =========================================================
   HEADER
========================================================= */

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(5,5,5,.96);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
}

.header-inner{
    max-width:1250px;
    margin:auto;
    padding:15px 18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
}

.brand{
    display:flex;
    align-items:center;
    gap:11px;
    cursor:pointer;
}

.brand-mark{
    width:38px;
    height:38px;
    border:2px solid var(--green);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--green);
    font-weight:900;
    font-size:12px;
    box-shadow:0 0 15px rgba(57,255,20,.2);
}

.brand-text{
    line-height:1;
}

.brand-text strong{
    display:block;
    font-size:18px;
    letter-spacing:2px;
}

.brand-text span{
    color:var(--green);
    font-size:9px;
    letter-spacing:3px;
}

.clock{
    color:var(--green);
    font-family:monospace;
    font-size:13px;
}


/* =========================================================
   NAVIGATION
========================================================= */

nav{
    display:flex;
    overflow-x:auto;
    border-top:1px solid #151515;
}

nav button{
    flex:1;
    min-width:95px;
    padding:13px 8px;
    background:none;
    border:0;
    color:#888;
    font-weight:bold;
    font-size:11px;
    letter-spacing:1px;
    cursor:pointer;
}

nav button.active{
    color:var(--green);
    border-bottom:2px solid var(--green);
}


/* =========================================================
   MAIN
========================================================= */

main{
    max-width:1250px;
    margin:auto;
    padding:20px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}


/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:390px;
    border:1px solid #25252b;
    border-radius:20px;
    overflow:hidden;
    position:relative;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(138,43,226,.3),
            transparent 35%
        ),

        radial-gradient(
            circle at 20% 80%,
            rgba(57,255,20,.08),
            transparent 35%
        ),

        #09090b;

    display:flex;
    align-items:flex-end;
}

.hero-content{
    padding:30px;
    max-width:750px;
}

.live-tag{
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:6px 10px;
    border-radius:4px;
    background:#190909;
    color:#ff5555;
    font-size:10px;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:15px;
}

.live-dot{
    width:7px;
    height:7px;
    background:#ff3131;
    border-radius:50%;
    box-shadow:0 0 10px red;
}

.hero h1{
    font-size:clamp(34px,7vw,70px);
    line-height:.95;
    margin-bottom:15px;
}

.hero h1 span{
    color:var(--green);
}

.hero p{
    color:#aaa;
    max-width:650px;
    line-height:1.6;
    margin-bottom:22px;
}

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.btn{
    border:0;
    padding:13px 17px;
    border-radius:7px;
    font-weight:bold;
    font-size:11px;
    letter-spacing:1px;
    cursor:pointer;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn-green{
    background:var(--green);
    color:#000;
}

.btn-purple{
    background:var(--purple);
    color:white;
}

.btn-dark{
    background:#17171b;
    color:white;
    border:1px solid #303036;
}


/* =========================================================
   PLAYER
========================================================= */

.player-wrap{
    margin-top:20px;
    background:#080808;
    border:1px solid #25252b;
    border-radius:16px;
    overflow:hidden;
}

.player{
    aspect-ratio:16/9;
    background:#000;
    position:relative;
    overflow:hidden;
}

#vv1LivePlayer{
    width:100%;
    height:100%;
    display:block;
    background:#000;
    object-fit:contain;
}


/* =========================================================
   PLAYER OVERLAYS
========================================================= */

.player-status{
    position:absolute;
    top:15px;
    left:15px;
    z-index:20;

    display:flex;
    align-items:center;
    gap:7px;

    background:rgba(5,5,5,.88);
    border:1px solid #333;

    padding:7px 10px;

    font-size:9px;
    color:var(--green);
    letter-spacing:1px;

    border-radius:4px;

    pointer-events:none;
}

.player-status .live-dot{
    width:6px;
    height:6px;
}

.player-message{
    position:absolute;
    inset:0;

    z-index:15;

    display:flex;
    align-items:center;
    justify-content:center;

    text-align:center;

    color:#777;
    font-size:11px;
    letter-spacing:2px;

    padding:30px;

    pointer-events:none;
}

.player-source{
    position:absolute;
    right:15px;
    bottom:15px;

    z-index:20;

    font-size:9px;
    color:#aaa;

    background:rgba(0,0,0,.75);

    padding:5px 8px;
    border-radius:3px;

    pointer-events:none;
}


/* =========================================================
   EXIT FULLSCREEN BUTTON
========================================================= */

.vv1-exit-fullscreen{
    position:absolute;

    top:18px;
    right:18px;

    z-index:100;

    background:rgba(5,5,5,.88);

    color:white;

    border:1px solid var(--green);

    padding:10px 13px;

    border-radius:6px;

    font-size:9px;
    font-weight:bold;

    letter-spacing:1px;

    cursor:pointer;

    opacity:0;
    pointer-events:none;

    transition:.2s;
}

.vv1-exit-fullscreen:hover{
    background:var(--green);
    color:#000;
}

.player:fullscreen .vv1-exit-fullscreen,
.player:-webkit-full-screen .vv1-exit-fullscreen,
.player:-moz-full-screen .vv1-exit-fullscreen{
    opacity:1;
    pointer-events:auto;
}


/* =========================================================
   PLAYER CONTROLS
========================================================= */

.player-controls{
    display:flex;
    align-items:center;
    justify-content:space-between;

    gap:10px;

    padding:10px 12px;

    background:#0b0b0d;

    border-top:1px solid #202025;
}

.player-control-buttons{
    display:flex;
    align-items:center;
    gap:8px;
}

.player-info{
    font-size:9px;
    color:#777;
    letter-spacing:1px;
}

.player-live{
    color:var(--red);
    font-weight:bold;
}


/* =========================================================
   FULLSCREEN BUTTON
========================================================= */

.fullscreen-btn{
    background:
        linear-gradient(
            135deg,
            var(--green),
            #25d80d
        );

    color:#000;

    border:0;

    padding:12px 15px;

    border-radius:7px;

    font-size:10px;

    font-weight:900;

    letter-spacing:1px;

    cursor:pointer;
}

.fullscreen-btn:hover{
    box-shadow:
        0 0 18px rgba(57,255,20,.4);
}


/* =========================================================
   TRUE BROWSER FULLSCREEN
========================================================= */

.player:fullscreen,
.player:-webkit-full-screen,
.player:-moz-full-screen{

    width:100vw !important;
    height:100vh !important;

    max-width:none !important;
    max-height:none !important;

    aspect-ratio:auto !important;

    border:0 !important;
    border-radius:0 !important;

    position:fixed;

    inset:0;

    background:
        radial-gradient(
            circle at 15% 20%,
            rgba(57,255,20,.30),
            transparent 35%
        ),

        radial-gradient(
            circle at 85% 80%,
            rgba(138,43,226,.38),
            transparent 40%
        ),

        #050505;

    z-index:999999;
}


/* =========================================================
   FULLSCREEN AMBIENT LIGHT
========================================================= */

.player:fullscreen::before,
.player:-webkit-full-screen::before,
.player:-moz-full-screen::before{

    content:"";

    position:absolute;

    inset:-20%;

    z-index:0;

    pointer-events:none;

    background:

        radial-gradient(
            circle at 10% 15%,
            rgba(57,255,20,.28),
            transparent 35%
        ),

        radial-gradient(
            circle at 90% 85%,
            rgba(138,43,226,.38),
            transparent 40%
        );

    animation:
        vv1Ambient 8s ease-in-out infinite alternate;
}

@keyframes vv1Ambient{

    from{
        transform:scale(1);
    }

    to{
        transform:scale(1.08);
    }
}


/* =========================================================
   FULLSCREEN VIDEO
========================================================= */

.player:fullscreen #vv1LivePlayer,
.player:-webkit-full-screen #vv1LivePlayer,
.player:-moz-full-screen #vv1LivePlayer{

    position:absolute;

    inset:0;

    width:100% !important;
    height:100% !important;

    object-fit:contain;

    z-index:2;

    background:transparent;
}


/* =========================================================
   FULLSCREEN OVERLAYS
========================================================= */

.player:fullscreen .player-status,
.player:-webkit-full-screen .player-status,
.player:-moz-full-screen .player-status{

    top:20px;
    left:20px;

    z-index:50;
}

.player:fullscreen .player-source,
.player:-webkit-full-screen .player-source,
.player:-moz-full-screen .player-source{

    right:20px;
    bottom:20px;

    z-index:50;
}

.player:fullscreen .player-message,
.player:-webkit-full-screen .player-message,
.player:-moz-full-screen .player-message{

    z-index:40;
}


/* =========================================================
   PORTRAIT FULLSCREEN
========================================================= */

@media (orientation:portrait){

    .player:fullscreen,
    .player:-webkit-full-screen,
    .player:-moz-full-screen{

        display:flex;

        align-items:center;
        justify-content:center;

        background:

            radial-gradient(
                circle at 0% 0%,
                rgba(57,255,20,.38),
                transparent 42%
            ),

            radial-gradient(
                circle at 100% 100%,
                rgba(138,43,226,.48),
                transparent 45%
            ),

            #050505;
    }

    .player:fullscreen #vv1LivePlayer,
    .player:-webkit-full-screen #vv1LivePlayer,
    .player:-moz-full-screen #vv1LivePlayer{

        position:relative;

        inset:auto;

        width:100vw !important;

        height:auto !important;

        aspect-ratio:16/9;

        max-width:100vw;

        max-height:100vh;

        object-fit:contain;

        background:#000;

        box-shadow:

            0 0 40px rgba(57,255,20,.15),

            0 0 80px rgba(138,43,226,.15);
    }
}


/* =========================================================
   LANDSCAPE FULLSCREEN
========================================================= */

@media (orientation:landscape){

    .player:fullscreen #vv1LivePlayer,
    .player:-webkit-full-screen #vv1LivePlayer,
    .player:-moz-full-screen #vv1LivePlayer{

        width:100vw !important;
        height:100vh !important;

        object-fit:contain;
    }
}


/* =========================================================
   JAVASCRIPT FALLBACK FULLSCREEN
========================================================= */

.player.vv1-fallback-fullscreen{

    position:fixed !important;

    inset:0 !important;

    width:100vw !important;
    height:100vh !important;

    max-width:none !important;
    max-height:none !important;

    aspect-ratio:auto !important;

    border-radius:0 !important;

    border:0 !important;

    z-index:999999 !important;

    display:flex;

    align-items:center;
    justify-content:center;

    background:

        radial-gradient(
            circle at 10% 10%,
            rgba(57,255,20,.35),
            transparent 40%
        ),

        radial-gradient(
            circle at 90% 90%,
            rgba(138,43,226,.45),
            transparent 45%
        ),

        #050505 !important;
}

.player.vv1-fallback-fullscreen #vv1LivePlayer{

    width:100% !important;
    height:100% !important;

    object-fit:contain;

    background:#000;
}

.player.vv1-fallback-fullscreen .vv1-exit-fullscreen{

    opacity:1;
    pointer-events:auto;
}


/* =========================================================
   SECTIONS
========================================================= */

.section{
    margin-top:28px;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:13px;
}

.section-head h2{
    font-size:17px;
}

.section-head span{
    color:var(--green);
    font-size:9px;
    letter-spacing:2px;
}

.grid{
    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(220px,1fr)
        );

    gap:12px;
}


/* =========================================================
   CARDS
========================================================= */

.card{
    background:var(--panel);

    border:1px solid #222229;

    border-radius:12px;

    padding:18px;

    cursor:pointer;

    transition:.2s;
}

.card:hover{
    border-color:var(--purple);
    transform:translateY(-2px);
}

.card-icon{
    width:40px;
    height:40px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:9px;

    background:#17131e;

    color:var(--green);

    margin-bottom:13px;

    font-weight:900;
}

.card h3{
    font-size:14px;
    margin-bottom:6px;
}

.card p{
    color:#888;
    font-size:11px;
    line-height:1.5;
}


/* =========================================================
   CHANNEL CARDS
========================================================= */

.channel-card{
    position:relative;
}

.channel-card.active-channel{
    border-color:var(--green);

    box-shadow:
        0 0 18px rgba(57,255,20,.08);
}

.channel-live{
    display:inline-flex;
    align-items:center;

    gap:6px;

    color:#ff5555;

    font-size:8px;

    font-weight:bold;

    letter-spacing:1px;

    margin-bottom:10px;
}

.channel-live-dot{
    width:6px;
    height:6px;

    border-radius:50%;

    background:#ff3131;

    box-shadow:0 0 8px red;
}


/* =========================================================
   GUIDE
========================================================= */

.guide{
    display:grid;
    gap:9px;
}

.program{
    display:grid;

    grid-template-columns:
        90px 1fr auto;

    align-items:center;

    gap:15px;

    padding:15px;

    background:var(--panel);

    border:1px solid #222229;

    border-radius:9px;
}

.program-time{
    color:var(--green);

    font-family:monospace;

    font-weight:bold;
}

.program-title{
    font-size:13px;
    font-weight:bold;
}

.program-desc{
    color:#777;

    font-size:10px;

    margin-top:4px;
}

.program-tag{
    color:#888;

    font-size:8px;

    letter-spacing:1px;
}


/* =========================================================
   TICKER
========================================================= */

.ticker{
    position:fixed;

    bottom:0;
    left:0;
    right:0;

    z-index:999;

    background:#080808;

    border-top:1px solid #25252b;

    display:flex;

    height:34px;
}

.ticker-label{
    background:var(--green);

    color:#000;

    display:flex;

    align-items:center;

    padding:0 13px;

    font-size:9px;

    font-weight:bold;

    letter-spacing:1px;
}

.ticker-content{
    flex:1;

    overflow:hidden;

    display:flex;

    align-items:center;

    white-space:nowrap;
}

.ticker-text{
    color:#bbb;

    font-size:10px;

    animation:
        ticker 25s linear infinite;

    padding-left:100%;
}

@keyframes ticker{

    from{
        transform:translateX(0);
    }

    to{
        transform:translateX(-100%);
    }
}


/* =========================================================
   FOOTER
========================================================= */

footer{
    padding:50px 20px 70px;

    text-align:center;

    color:#555;

    font-size:9px;

    letter-spacing:1px;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:600px){

    main{
        padding:12px;
    }

    .header-inner{
        padding:12px;
    }

    .clock{
        font-size:10px;
    }

    .hero{
        min-height:420px;
    }

    .hero-content{
        padding:22px;
    }

    .hero h1{
        font-size:43px;
    }

    .grid{
        grid-template-columns:1fr 1fr;
    }

    .program{
        grid-template-columns:
            70px 1fr;
    }

    .program-tag{
        display:none;
    }

    .btn{
        width:100%;
    }

    .player-controls{
        align-items:stretch;
        flex-direction:column;
    }

    .player-control-buttons{
        width:100%;
    }

    .player-control-buttons .btn,
    .player-control-buttons .fullscreen-btn{
        flex:1;
        width:auto;
    }

    .vv1-exit-fullscreen{
        top:12px;
        right:12px;
    }
}


/* =========================================================
   SMALL PHONES
========================================================= */

@media(max-width:380px){

    .grid{
        grid-template-columns:1fr;
    }
}


/* =========================================================
   FULLSCREEN MOBILE UI
========================================================= */

@media(max-width:600px){

    .player:fullscreen .player-status,
    .player:-webkit-full-screen .player-status,
    .player:-moz-full-screen .player-status{

        top:12px;
        left:12px;

        font-size:8px;
    }

    .player:fullscreen .player-source,
    .player:-webkit-full-screen .player-source,
    .player:-moz-full-screen .player-source{

        right:12px;
        bottom:12px;
    }
}

</style>

</head>


